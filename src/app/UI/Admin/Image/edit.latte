{templateType App\UI\BaseTemplate}

{layout $layoutFile}

{block h1}{_'header_editImage'}{/block}

{block content}
    {embed languageSelect, defaultId: $presenter->getParameter('languageId')}{/embed}
    {embed basicForm, formEdit}
        {block beforeControls}{include imagePreviewWithLanguageFile, $form}{/block}
    {/embed}
{/block}